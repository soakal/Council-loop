{
  "target_repo": "C:/absolute/path/to/your/repo",
  "git_clone_url": "https://github.com/you/your-repo.git",
  "ceiling": {
    "max_cycles": 10,
    "max_minutes": 60
  },
  "revise_attempts": 2,
  "models": {
    "arbiter": "opus",
    "engineer": "sonnet",
    "realist": "sonnet",
    "security": "sonnet",
    "verifier": "sonnet"
  },
  "dry_run": false,
  "open_pr": false,
  "transcripts": true,
  "test_commands": [],
  "auto_commit": true,
  "commit_prefix": "council:",
  "dynamic_agents": {
    "enabled": false,
    "max_parallel": 4,
    "timeout_minutes": 10
  },
  "verifier": {
    "enabled": true,
    "max_test_files": 2
  }
}
