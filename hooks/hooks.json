{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/validate_after_edit.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep|Glob|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/guard.py\" || python \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/guard.py\" || py -3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/guard.py\""
          }
        ]
      }
    ]
  }
}
